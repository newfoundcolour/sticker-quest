// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// CUSTOMER is the default for every signup (set by the auth.users trigger,
/// never by a form or API). STAFF/ADMIN are granted by hand in the database.
enum Role {
  ADMIN
  STAFF
  CUSTOMER
}

enum StickerType {
  VINYL
  HOLOGRAPHIC
  CHROME
  CLEAR
  ECONOMY
  STICKER_SHEETS
  LABEL_SHEETS
}

enum CutType {
  KISS
  DIE
}

enum Shape {
  SQUARE
  CIRCLE
  RECTANGLE
  OVAL
  CUSTOM
}

enum Finish {
  MATTE
  GLOSS
}

/// How many individual stickers are on one sticker sheet; each tier adds a
/// percentage surcharge (see PRICING_SETTING_KEYS in src/lib/pricingConstants.ts).
enum SheetCuts {
  CUTS_1_4
  CUTS_5_8
  CUTS_9_12
}

/// Pipeline: AWAITING_PROOF -> AWAITING_APPROVAL (proof sent, waiting on the
/// customer) -> APPROVED -> PRINTING -> SHIPPED. A rejected proof sends the
/// order back to AWAITING_PROOF.
enum OrderStatus {
  AWAITING_PROOF
  AWAITING_APPROVAL
  APPROVED
  PRINTING
  SHIPPED
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Who made a proof decision: the customer in their account, or staff
/// recording an approval given elsewhere (e.g. on WhatsApp).
enum ProofDecisionSource {
  CUSTOMER
  STAFF_ON_BEHALF
}

/// Mirrors a Supabase Auth user (auth.users) 1:1 — id is that user's uuid,
/// not a locally generated id. Supabase Auth owns credentials; this table
/// holds the app-specific role and profile details. Rows are created and
/// their email kept in sync by triggers on auth.users (see the
/// customer_accounts migration). Authorisation reads `role` from here only —
/// never from Supabase user_metadata, which users can edit themselves.
model Profile {
  id              String   @id
  email           String   @unique
  role            Role     @default(CUSTOMER)
  firstName       String   @default("")
  lastName        String   @default("")
  company         String?
  phone           String?
  instagramHandle String?
  /// Delivery address, collected in the cart before checkout (all required to place an order).
  addressLine1    String?
  addressLine2    String?
  city            String?
  province        String?
  postalCode      String?
  orders          Order[]
  conversations   SupportConversation[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Fixed-window request counters for our own server actions and routes
/// (auth endpoints, uploads). See src/lib/rateLimit.ts.
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}

/// Base material rate for one sticker type, in cents per square cm. Price is
/// computed as area x rate (see src/lib/pricing.ts), not looked up directly —
/// this table just holds the editable rate inputs to that formula, so rates
/// can change without a deploy.
model PricingRule {
  id          String      @id @default(cuid())
  stickerType StickerType @unique
  ratePerSqCm Decimal     @db.Decimal(6, 2)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

/// Bulk discount curve applied to the per-unit price, relative to the
/// 50-unit baseline (no discount). Editable data, not hardcoded percentages.
model QuantityDiscountTier {
  id              String   @id @default(cuid())
  minQuantity     Int      @unique
  discountPercent Decimal  @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

/// Single global pricing knobs that aren't per-type or per-quantity-tier,
/// e.g. the white ink rate and lamination surcharge. See PRICING_SETTING_KEYS
/// in src/lib/pricing.ts for the keys the formula reads.
model PricingSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Decimal  @db.Decimal(6, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id     String      @id @default(cuid())
  status OrderStatus @default(AWAITING_PROOF)

  customerName    String
  email           String
  phone           String
  shippingAddress String

  /// The customer account this order belongs to. Null for guest orders; set
  /// at checkout when a verified customer is logged in, or later when a
  /// guest order's email matches an account's Supabase-verified email.
  userId String?
  user   Profile? @relation(fields: [userId], references: [id], onDelete: SetNull)

  items  OrderItem[]
  proofs Proof[]
  conversations SupportConversation[]

  trackingNumber String?
  notes          String?
  /// Flat shipping fee charged on this order (0 for orders placed before shipping was charged).
  shippingFee    Decimal @default(0) @db.Decimal(10, 2)
  /// What the customer paid: the sum of each item's totalPrice plus shippingFee, captured at checkout.
  totalPrice     Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([userId, createdAt])
  @@index([email])
}

/// One configured sticker line within an order — a cart line item that
/// survived checkout. pricePerUnit/totalPrice are captured at checkout time
/// (from the live PricingRule data), not recomputed later, so historic
/// orders stay accurate if rates change.
model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  stickerType    StickerType
  cutType        CutType
  shape          Shape
  finish         Finish
  /// Only ever true for square and rectangle stickers.
  roundedCorners Boolean     @default(false)
  whiteInk       Boolean     @default(false)
  lamination     Boolean     @default(false)
  widthCm        Decimal     @db.Decimal(6, 2)
  heightCm       Decimal     @db.Decimal(6, 2)
  quantity       Int
  /// Sticker sheets only: the material the sheet is printed on (vinyl,
  /// holographic, chrome or clear) and how many stickers are cut from it.
  sheetMaterial  StickerType?
  sheetCuts      SheetCuts?

  artworkUrl      String
  artworkFilename String?

  pricePerUnit Decimal @db.Decimal(10, 2)
  totalPrice   Decimal @db.Decimal(10, 2)

  createdAt DateTime @default(now())

  @@index([orderId])
}

/// One version of a print proof for an order. Every version is kept — a new
/// upload adds version N+1 and never overwrites. Only the latest version can
/// be approved or rejected; older pending ones count as superseded.
/// The file lives in the private "proofs" Supabase Storage bucket and is only
/// ever served through a short-lived signed URL after an ownership check.
model Proof {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  version          Int
  /// Path inside the "proofs" bucket, e.g. orders/<orderId>/<random>.pdf
  storagePath      String   @unique
  originalFilename String
  /// Detected from the file's bytes, not the browser's claim.
  mimeType         String
  sizeBytes        Int

  status          ProofStatus          @default(PENDING)
  customerComment String?
  decidedAt       DateTime?
  /// Supabase user id of whoever recorded the decision.
  decidedBy       String?
  decisionSource  ProofDecisionSource?

  /// Supabase user id of the staff member who uploaded it.
  uploadedBy String
  createdAt  DateTime @default(now())

  @@unique([orderId, version])
  @@index([orderId, createdAt])
  @@index([status])
}

enum SupportCategory {
  PRINT_QUALITY
  WRONG_SIZE
  WRONG_DESIGN
  DAMAGED_IN_SHIPPING
  MISSING_ITEM
  SHIPPING_DELIVERY
  OTHER
}

enum ConversationStatus {
  OPEN
  RESOLVED
}

enum MessageSender {
  CUSTOMER
  STAFF
}

/// A private support thread between one customer and staff. Each "New
/// message" from the customer starts a new conversation; replying to a
/// resolved one reopens it.
model SupportConversation {
  id       String          @id @default(cuid())
  userId   String
  user     Profile         @relation(fields: [userId], references: [id], onDelete: Cascade)
  category SupportCategory
  /// Optional link to one of the customer's own orders (ownership checked on create).
  orderId  String?
  order    Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)

  status        ConversationStatus @default(OPEN)
  lastMessageAt DateTime           @default(now())
  resolvedAt    DateTime?
  createdAt     DateTime           @default(now())

  messages SupportMessage[]

  @@index([userId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([orderId])
}

/// One message in a support thread. Body is plain text (rendered escaped,
/// max 5,000 characters). An optional reference image lives in the private
/// "support-attachments" bucket and is only served via a signed URL after
/// an ownership check.
model SupportMessage {
  id             String              @id @default(cuid())
  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         MessageSender
  /// Supabase user id of the customer or staff member who sent it.
  senderUserId   String
  body           String
  attachmentPath String?
  attachmentName String?
  createdAt      DateTime            @default(now())
  /// When the other side first saw it; null = unread.
  readAt         DateTime?

  @@index([conversationId, createdAt])
  @@index([conversationId, sender, readAt])
}
